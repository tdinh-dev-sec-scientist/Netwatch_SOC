# NetWatch SOC — environment template.
#
#   cp .env.example .env     # docker compose reads .env automatically
#
# Nothing here is a secret worth protecting: these are local development
# defaults. .env itself is gitignored — put real credentials only there, or
# better, in your platform's secret store.

# ── database ────────────────────────────────────────────────────────────────
# PostgreSQL is the production database and the default; DB_BACKEND only needs
# setting to choose the SQLite development fallback.
DB_BACKEND=postgresql

# The preferred form: one connection string. Overrides every PG_* variable
# below. `postgres` is the compose service name, so this value works as-is
# inside the compose network; from your host use localhost instead.
DATABASE_URL=postgresql://netwatch:netwatch@postgres:5432/netwatch

# Discrete fallback, used only when DATABASE_URL is unset. PG_DB is required;
# the rest have defaults.
#PG_HOST=localhost
#PG_PORT=5432
#PG_USER=netwatch
#PG_PASSWORD=netwatch
#PG_DB=netwatch
# require / verify-full for a managed database reached over the internet;
# leave unset for a local one over a private network.
#PG_SSLMODE=require

# Reader connection pool. Keep PG_POOL_MAX at or above GUNICORN_THREADS, or
# requests queue waiting for a connection.
PG_POOL_MIN=1
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT=10
# Ceiling on any single statement, so a pathological query cannot pin a worker.
PG_STATEMENT_TIMEOUT_MS=30000

# Apply pending migrations on startup. Convenient locally; set to 0 in a
# deployment where migrations should be an explicit release step, and run
# `python migrate.py up` from there instead.
NETWATCH_AUTO_MIGRATE=1

# What the postgres container initialises itself with. These must agree with
# DATABASE_URL above.
POSTGRES_DB=netwatch
POSTGRES_USER=netwatch
POSTGRES_PASSWORD=netwatch

# Where the test suite creates and drops its scratch databases. It never
# touches the database named here, only `netwatch_test_*` alongside it.
TEST_DATABASE_URL=postgresql://netwatch:netwatch@localhost:5432/netwatch

# ── SQLite fallback (development only) ──────────────────────────────────────
# Set DB_BACKEND=sqlite to use it. Not supported in production: no JSONB, no
# type enforcement, and one writer at a time. See the README.
#DB_BACKEND=sqlite
#NETWATCH_DB=./netwatch.db

# ── application ─────────────────────────────────────────────────────────────
NETWATCH_SIMULATE=1          # generate synthetic traffic
NETWATCH_RATE_PPS=95         # live packets per second
NETWATCH_BACKFILL_MIN=0      # minutes of history to generate at startup
NETWATCH_RETENTION_S=0       # delete telemetry older than this; 0 keeps all
#NETWATCH_CONFIG=./thresholds.json   # JSON detection-threshold overrides
#NETWATCH_HOST=127.0.0.1
#NETWATCH_PORT=5001

# ── hardening ───────────────────────────────────────────────────────────────
NETWATCH_DEMO=0              # 1 refuses every non-GET request with 403
NETWATCH_RATE_LIMIT=0        # per-client requests per window, e.g. 600/60
NETWATCH_GLOBAL_RATE_LIMIT=0 # overall requests per window
NETWATCH_PROXY_HOPS=0        # reverse proxies to trust for X-Forwarded-For

# ── gunicorn ────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=1           # must stay 1 while NETWATCH_SIMULATE=1
GUNICORN_THREADS=8
GUNICORN_LOGLEVEL=info
